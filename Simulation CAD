<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Vineyard Sprayer — Interactive 3D Concept</title><style>*{box-sizing:border-box}body{margin:0;background:#101923;color:#e9f1f5;font:15px system-ui,Arial}header{padding:17px 22px;border-bottom:1px solid #344653}h1{font-size:21px;margin:0 0 5px}p{margin:0;color:#aebfc9}.layout{display:grid;grid-template-columns:minmax(0,1fr) 290px;min-height:calc(100vh - 80px)}main{position:relative;min-height:540px;background:linear-gradient(#dce8ee,#b5c9d0)}canvas{width:100%;height:100%;display:block;touch-action:none;cursor:grab}main:active canvas{cursor:grabbing}.hint{position:absolute;left:15px;bottom:14px;background:#15232bdc;color:white;padding:8px 11px;border-radius:7px;font-size:12px}aside{padding:20px;background:#172633;border-left:1px solid #354955}label{display:block;margin:18px 0 7px;font-weight:650}button{border:1px solid #516c7b;background:#253b4a;color:#fff;border-radius:8px;padding:10px 12px;cursor:pointer;margin:3px 2px 3px 0}button.active{background:#087d85;border-color:#29b6bb}button:hover{filter:brightness(1.18)}input{width:100%;accent-color:#26c6b9}.value{float:right;color:#77e0d5}.note{font-size:12px;line-height:1.5;color:#a8bac5;margin-top:25px}@media(max-width:760px){.layout{grid-template-columns:1fr}main{min-height:440px;height:56vh}aside{border-left:0;border-top:1px solid #354955}}</style></head><body><header><h1>Dual-Row Vineyard Sprayer · 3D Concept</h1><p>Based on your sketch · Offline interactive viewer · Not dimensioned for fabrication</p></header><div class="layout"><main><canvas id="view"></canvas><div class="hint">Drag to rotate · Scroll to zoom · Both nozzle banks spray outward</div></main><aside><label>Appearance</label><button id="real" class="active">Realistic</button><button id="cad">Engineering CAD</button><label>Camera views</label><button data-view="iso">Isometric</button><button data-view="front">Front</button><button data-view="side">Side</button><button data-view="top">Top</button><label>Spray output <span id="sprayvalue" class="value">60%</span></label><input id="spray" type="range" min="0" max="100" value="60"><label>Assembly</label><button id="explode">Exploded view: OFF</button><button id="reset">Reset camera</button><div class="note">Conceptual trailer, wheels, central tank, pump, hitch, and three nozzles per side. This viewer uses no external libraries or network access. The spray cones are illustrative, not CFD or a calibrated nozzle pattern.</div></aside></div><script>
(()=>{'use strict';const c=document.getElementById('view'),ctx=c.getContext('2d');let yaw=.68,pitch=.32,zoom=1,mode='real',spray=60,explode=false,drag=false,lastX=0,lastY=0;const $=id=>document.getElementById(id);let faces=[],lines=[];
function v(x,y,z){return [x,y,z]}function rot(p){let [x,y,z]=p;let a=Math.cos(yaw),b=Math.sin(yaw),xx=x*a-z*b,zz=x*b+z*a;let d=Math.cos(pitch),e=Math.sin(pitch);return [xx,y*d-zz*e,y*e+zz*d]}
function project(p,w,h){let q=rot(p),s=Math.min(w/10,h/7)*zoom,depth=12+q[2];let perspective=12/depth;return [w/2+q[0]*s*perspective,h*.56-q[1]*s*perspective,q[2]]}
function face(points,color,stroke='#26343b',alpha=1){faces.push({points,color,stroke,alpha,depth:points.reduce((t,p)=>t+rot(p)[2],0)/points.length})}
function edge(a,b,color='#293b46',width=2,dash=false){lines.push({a,b,color,width,dash,depth:(rot(a)[2]+rot(b)[2])/2})}
function box(x,y,z,w,h,d,color){let p=[v(x-w/2,y-h/2,z-d/2),v(x+w/2,y-h/2,z-d/2),v(x+w/2,y+h/2,z-d/2),v(x-w/2,y+h/2,z-d/2),v(x-w/2,y-h/2,z+d/2),v(x+w/2,y-h/2,z+d/2),v(x+w/2,y+h/2,z+d/2),v(x-w/2,y+h/2,z+d/2)];[[0,1,2,3],[5,4,7,6],[4,0,3,7],[1,5,6,2],[3,2,6,7],[4,5,1,0]].forEach((ids,i)=>face(ids.map(k=>p[k]),shade(color,[.8,.72,.82,.94,1.12,.66][i])))}
function shade(hex,f){let n=parseInt(hex.slice(1),16);return '#'+[n>>16,(n>>8)&255,n&255].map(x=>Math.max(0,Math.min(255,Math.round(x*f))).toString(16).padStart(2,'0')).join('')}
function tube(a,b,r,color){let n=8;let dx=b[0]-a[0],dy=b[1]-a[1],dz=b[2]-a[2],len=Math.hypot(dx,dy,dz),u=[dx/len,dy/len,dz/len],ref=Math.abs(u[1])<.9?[0,1,0]:[1,0,0],cross=(p,q)=>[p[1]*q[2]-p[2]*q[1],p[2]*q[0]-p[0]*q[2],p[0]*q[1]-p[1]*q[0]];let e=cross(u,ref),en=Math.hypot(...e);e=e.map(x=>x/en);let f=cross(u,e);for(let i=0;i<n;i++){let mk=(pt,t)=>pt.map((x,j)=>x+r*(e[j]*Math.cos(t)+f[j]*Math.sin(t)));let t=i*2*Math.PI/n,t2=(i+1)*2*Math.PI/n;face([mk(a,t),mk(a,t2),mk(b,t2),mk(b,t)],shade(color,.75+.35*Math.cos(t)))}}
function wheel(x,z){let y=.48;let n=18;for(let i=0;i<n;i++){let t=i*2*Math.PI/n,u=(i+1)*2*Math.PI/n;face([[x-.14,y+.47*Math.sin(t),z+.47*Math.cos(t)],[x-.14,y+.47*Math.sin(u),z+.47*Math.cos(u)],[x+.14,y+.47*Math.sin(u),z+.47*Math.cos(u)],[x+.14,y+.47*Math.sin(t),z+.47*Math.cos(t)]],mode==='cad'?'#546b78':'#242a2c');}for(let side of [-1,1]){let pts=[];for(let i=0;i<20;i++){let t=i*2*Math.PI/20;pts.push([x+side*.15,y+.3*Math.sin(t),z+.3*Math.cos(t)])}face(pts,mode==='cad'?'#b2c8d0':'#657176')}}
function build(){faces=[];lines=[];let frame=mode==='cad'?'#6c8797':'#343d40',metal=mode==='cad'?'#9bb5c4':'#adb6b8',tank=mode==='cad'?'#e1eff6':'#e6e9e5',green=mode==='cad'?'#79b4c6':'#36824a';let offset=explode?1.0:0;
// Forward hitch at negative z; rear sprayer at positive z.
box(0,.97,0,3.05,.20,4.2,frame);for(let x of [-1.33,1.33])tube([x,.83,-2],[x,.83,2],.10,metal);tube([-.8,.94,-2],[0,.75,-3.5],.10,frame);tube([.8,.94,-2],[0,.75,-3.5],.10,frame);tube([0,.75,-3.5],[0,.75,-3.95],.12,metal);
for(let z of [-1.5,1.5])for(let x of [-1.5,1.5])wheel(x,z);
let tz=-.15+(explode?-.35:0);box(0,2.02,tz,2.25,1.75,2.5,tank);box(0,2.93,tz,.7,.15,.65,metal);box(0,1.12,1.42,1.03,.54,.68,green);box(0,1.5,1.42,.48,.18,.5,metal);
for(let side of [-1,1]){let x=side*(1.55+offset);tube([x,1.02,1.3],[x,3.68,1.3],.075,metal);tube([0,1.43,1.42],[x,1.43,1.3],.055,green);for(let i=0;i<3;i++){let y=1.78+i*.77;tube([x,y,1.3],[x+side*.28,y,1.3],.09,metal);box(x+side*.28,y,1.3,.18,.16,.18,green);if(spray>0){let tip=[x+side*.38,y,1.3],spread=.34+spray/120;let end=[tip[0]+side*(.65+spray/90),y,1.3];for(let k=0;k<7;k++){let t=k*Math.PI/3;edge(tip,[end[0],end[1]+Math.sin(t)*spread,end[2]+Math.cos(t)*spread],mode==='cad'?'#268bba':'#35b9e0',1.5,true)}}}}
}
function render(){let w=c.clientWidth,h=c.clientHeight,dpr=Math.min(devicePixelRatio||1,2);if(c.width!==Math.round(w*dpr)||c.height!==Math.round(h*dpr)){c.width=Math.round(w*dpr);c.height=Math.round(h*dpr)}ctx.setTransform(dpr,0,0,dpr,0,0);ctx.clearRect(0,0,w,h);build();faces.sort((a,b)=>b.depth-a.depth);for(let f of faces){let ps=f.points.map(p=>project(p,w,h));ctx.beginPath();ps.forEach((p,i)=>i?ctx.lineTo(p[0],p[1]):ctx.moveTo(p[0],p[1]));ctx.closePath();ctx.fillStyle=f.color;ctx.globalAlpha=f.alpha;ctx.fill();ctx.strokeStyle=f.stroke;ctx.lineWidth=mode==='cad'?1.1:.55;ctx.stroke()}ctx.globalAlpha=1;lines.sort((a,b)=>b.depth-a.depth);for(let l of lines){let a=project(l.a,w,h),b=project(l.b,w,h);ctx.beginPath();ctx.moveTo(a[0],a[1]);ctx.lineTo(b[0],b[1]);ctx.strokeStyle=l.color;ctx.lineWidth=l.width;ctx.setLineDash(l.dash?[5,5]:[]);ctx.stroke()}ctx.setLineDash([]);ctx.fillStyle='#193440';ctx.font='bold 13px system-ui';ctx.fillText('CONCEPT MODEL • NOT TO SCALE',14,25)}
function view(name){if(name==='iso'){yaw=.68;pitch=.32}else if(name==='front'){yaw=0;pitch=.05}else if(name==='side'){yaw=Math.PI/2;pitch=.06}else if(name==='top'){yaw=.25;pitch=1.48}render()}
c.addEventListener('pointerdown',e=>{drag=true;lastX=e.clientX;lastY=e.clientY;c.setPointerCapture(e.pointerId)});c.addEventListener('pointermove',e=>{if(!drag)return;yaw+=(e.clientX-lastX)*.009;pitch=Math.max(-1.45,Math.min(1.5,pitch+(e.clientY-lastY)*.009));lastX=e.clientX;lastY=e.clientY;render()});c.addEventListener('pointerup',()=>drag=false);c.addEventListener('wheel',e=>{e.preventDefault();zoom=Math.max(.45,Math.min(3,zoom*Math.exp(-e.deltaY*.001)));render()},{passive:false});$('real').onclick=()=>{mode='real';$('real').classList.add('active');$('cad').classList.remove('active');render()};$('cad').onclick=()=>{mode='cad';$('cad').classList.add('active');$('real').classList.remove('active');render()};document.querySelectorAll('[data-view]').forEach(b=>b.onclick=()=>view(b.dataset.view));$('spray').oninput=e=>{spray=+e.target.value;$('sprayvalue').textContent=spray+'%';render()};$('explode').onclick=()=>{explode=!explode;$('explode').textContent='Exploded view: '+(explode?'ON':'OFF');render()};$('reset').onclick=()=>{zoom=1;view('iso')};window.addEventListener('resize',render);render();
})();
</script></body></html>
