<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Vineyard Sprayer ROI Simulator</title><style>:root{font-family:Inter,system-ui,Arial,sans-serif;color:#eaf4ed;background:#0b1713}*{box-sizing:border-box}body{margin:0;padding:32px 16px}.wrap{max-width:1050px;margin:auto}h1{font-size:clamp(26px,4vw,42px);margin:0 0 8px}p{color:#a8bdb1;line-height:1.5}.eyebrow{color:#72d9a0;font-size:12px;letter-spacing:.15em;font-weight:700}.layout{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:24px}.panel{background:#14251d;border:1px solid #2c4637;border-radius:18px;padding:24px}.control{margin:22px 0}label{display:flex;justify-content:space-between;gap:12px;font-size:14px;font-weight:600}output{color:#86e6ad;font-variant-numeric:tabular-nums}input[type=range]{width:100%;accent-color:#66d998;margin-top:12px;cursor:pointer}.hint{font-size:12px;color:#91a99b;margin-top:4px}.metrics{display:grid;grid-template-columns:1fr 1fr;gap:12px}.metric{background:#20372a;padding:17px;border-radius:12px}.metric span{font-size:12px;color:#a9c2b2}.metric strong{display:block;font-size:clamp(21px,3vw,30px);margin-top:7px;font-variant-numeric:tabular-nums}.green{color:#84e8a9}h2{font-size:18px;margin:0 0 16px}canvas{width:100%;height:250px;display:block}table{width:100%;border-collapse:collapse;font-size:14px}td,th{padding:11px 5px;border-bottom:1px solid #2c4637;text-align:right}td:first-child,th:first-child{text-align:left}.note{font-size:12px;color:#9eb5a6}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}button{border:1px solid #4d8562;background:#28543b;color:white;border-radius:9px;padding:11px 15px;cursor:pointer;font-weight:650}button:hover{background:#356e4c}@media(max-width:760px){.layout{grid-template-columns:1fr}.panel{padding:18px}}</style></head><body><main class="wrap"><div class="eyebrow">AGTECH • FINANCIAL MODEL</div><h1>Vineyard Sprayer ROI Simulator</h1><p>Estimate pesticide cost savings, acreage needed to break even, and payback time for a variable-rate sprayer retrofit. Adjust the sliders to test different farm scenarios.</p><div class="layout"><section class="panel"><h2>Farm & equipment assumptions</h2><div id="controls"></div><div class="actions"><button id="reset">Reset assumptions</button><button id="csv">Download cash-flow CSV</button></div></section><section class="panel"><h2>Investment results</h2><div class="metrics"><div class="metric"><span>Annual net savings</span><strong class="green" id="annual"></strong></div><div class="metric"><span>Simple payback</span><strong id="payback"></strong></div><div class="metric"><span>Acres for 1-year payback</span><strong id="acresNeeded"></strong></div><div class="metric"><span>5-year net cash flow</span><strong id="five"></strong></div></div><h2 style="margin-top:26px">Cumulative net cash flow</h2><canvas id="chart" width="900" height="420" aria-label="Cash flow chart" role="img"></canvas><p class="note">Green line = cumulative net cash flow. Dashed line = $0 break-even.</p><h2 style="margin-top:25px">Year-by-year breakdown</h2><table><thead><tr><th>Year</th><th>Annual net savings</th><th>Cumulative cash flow</th></tr></thead><tbody id="rows"></tbody></table></section></div><p class="note">Illustrative model only. Assumes annual pesticide cost per acre is eligible for the selected reduction, steady yearly savings, and no crop-yield or pest-control penalty. Excludes taxes, financing, discounting, inflation, equipment replacement, and any costs not entered. Validate field performance and full installed cost before using results for investment decisions.</p></main><script>const config=[['investment','Initial investment ($)',5000,1000,30000,250],['acres','Farm size (acres)',50,5,1000,5],['cost','Annual pesticide cost per acre ($)',250,25,1000,25],['saving','Pesticide savings (%)',15,0,70,1],['maintenance','Annual operating & maintenance cost ($)',0,0,5000,50]];let state=Object.fromEntries(config.map(c=>[c[0],c[2]]));const money=n=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(n);const controls=document.getElementById('controls');config.forEach(([key,label,def,min,max,step])=>{let el=document.createElement('div');el.className='control';el.innerHTML=`<label for="${key}">${label}<output id="${key}Out"></output></label><input type="range" id="${key}" min="${min}" max="${max}" step="${step}" value="${def}">`;controls.append(el);el.querySelector('input').addEventListener('input',e=>{state[key]=+e.target.value;update()})});function model(){let gross=state.acres*state.cost*state.saving/100,net=gross-state.maintenance;return{gross,net,payback:net>0?state.investment/net:Infinity,needed:state.cost*state.saving/100>0?Math.ceil((state.investment+state.maintenance)/(state.cost*state.saving/100)):Infinity}}function update(){config.forEach(([k,label])=>{document.getElementById(k).value=state[k];document.getElementById(k+'Out').textContent=k==='saving'?state[k]+'%':k==='acres'?state[k].toLocaleString():money(state[k])});const m=model();document.getElementById('annual').textContent=money(m.net);document.getElementById('payback').textContent=Number.isFinite(m.payback)?m.payback.toFixed(2)+' years':'No payback';document.getElementById('acresNeeded').textContent=Number.isFinite(m.needed)?m.needed.toLocaleString()+' acres':'N/A';document.getElementById('five').textContent=money(m.net*5-state.investment);document.getElementById('rows').innerHTML=Array.from({length:11},(_,y)=>`<tr><td>${y}</td><td>${y?money(m.net):'—'}</td><td style="color:${y*m.net-state.investment>=0?'#84e8a9':'#f5b0a3'}">${money(y*m.net-state.investment)}</td></tr>`).join('');draw(m.net)}function draw(net){const c=document.getElementById('chart'),ctx=c.getContext('2d'),w=c.width,h=c.height;ctx.clearRect(0,0,w,h);const left=110,right=25,top=30,bottom=60;let vals=Array.from({length:11},(_,i)=>i*net-state.investment);let low=Math.min(0,...vals),high=Math.max(0,...vals);if(high===low){high+=1;low-=1}const xp=i=>left+i*(w-left-right)/10,yp=v=>top+(high-v)*(h-top-bottom)/(high-low);ctx.font='20px system-ui';ctx.textAlign='right';ctx.fillStyle='#9eb5a6';for(let j=0;j<=4;j++){let v=low+(high-low)*j/4,y=yp(v);ctx.strokeStyle='#30483a';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(left,y);ctx.lineTo(w-right,y);ctx.stroke();ctx.fillText(money(v),left-15,y+6)}ctx.setLineDash([9,7]);ctx.strokeStyle='#d5a06c';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(left,yp(0));ctx.lineTo(w-right,yp(0));ctx.stroke();ctx.setLineDash([]);ctx.strokeStyle='#7ce3a5';ctx.lineWidth=5;ctx.beginPath();vals.forEach((v,i)=>i?ctx.lineTo(xp(i),yp(v)):ctx.moveTo(xp(i),yp(v)));ctx.stroke();ctx.textAlign='center';ctx.fillStyle='#c1d3c5';for(let i=0;i<=10;i+=2)ctx.fillText(String(i),xp(i),h-22);ctx.fillText('Years',w/2,h-2)}document.getElementById('reset').onclick=()=>{state=Object.fromEntries(config.map(c=>[c[0],c[2]]));update()};document.getElementById('csv').onclick=()=>{const m=model();let lines=['Year,Annual net savings,Cumulative net cash flow'];for(let y=0;y<=10;y++)lines.push(`${y},${y?m.net:0},${y*m.net-state.investment}`);let blob=new Blob([lines.join('\n')],{type:'text/csv'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='vineyard_sprayer_cash_flow.csv';a.click();URL.revokeObjectURL(url)};update();</script></body></html>
